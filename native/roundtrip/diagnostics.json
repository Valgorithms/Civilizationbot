{
  "schema": "civilizationbot.native-diagnostics.v1",
  "max_log_bytes": 4096,
  "max_lines": 128,
  "fatal_patterns": [
    "runtime[ \\t]+error",
    "bad[ \\t]+ref",
    "##[ \\t]*error",
    "runtime[ \\t]*:",
    "segmentation",
    "assertion[ \\t]+failed",
    "fatal[ \\t]+error",
    "\\bwarning\\b",
    "\\bexception\\b",
    "\\bbug[ \\t]*:",
    "\\berror\\b"
  ],
  "known_harmless_patterns": [
    "^BYOND Server Daemon v516\\.1688$",
    "^Dream Daemon version 516\\.1688$",
    "^Loading (save_bridge|fixture_generator)\\.dmb\\.\\.\\.$",
    "^World startup complete\\.$",
    "^World opened on (network )?port none\\.$"
  ],
  "unknown_nonempty_output": "reject",
  "native_catalog_observed_in_this_task": false
}
